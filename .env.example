DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yardli?schema=public"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (redirect URI: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps — Maps JavaScript, Geocoding and Places APIs
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Resend — estimate, invoice and invite emails
RESEND_API_KEY=
RESEND_ADMIN_KEY=
RESEND_FROM_EMAIL=

# Stripe — subscriptions (see docs/STRIPE_SETUP.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# Upstash Redis — rate limiting (see docs/RATE_LIMIT.md); set RATELIMIT_DISABLED=true locally to skip
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATELIMIT_DISABLED=

# Comma-separated user IDs with access to /admin
ADMIN_USER_IDS=
